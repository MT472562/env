#!/usr/bin/env bash
# ~/.local に展開した fish を、データディレクトリ付きで起動するラッパ
# （バイナリが /usr/share/fish を参照するため bwrap で重ねる）
set -euo pipefail

FISH_BIN="${FISH_BIN:-$HOME/.local/bin/fish}"
FISH_SHARE="${FISH_SHARE:-$HOME/.local/share/fish}"

if [ ! -x "$FISH_BIN" ]; then
  echo "fish がありません: $FISH_BIN" >&2
  echo "  setup するか: apt install fish" >&2
  exit 1
fi

if [ ! -d "$FISH_SHARE/functions" ]; then
  echo "fish のデータが不完全です: $FISH_SHARE" >&2
  exit 1
fi

if command -v bwrap >/dev/null 2>&1; then
  exec bwrap \
    --bind / / \
    --dev-bind /dev /dev \
    --proc /proc \
    --bind "$FISH_SHARE" /usr/share/fish \
    --setenv PATH "$HOME/.local/bin:$PATH" \
    "$FISH_BIN" "$@"
else
  # bwrap が無い場合は素の fish（機能が欠ける可能性あり）
  exec "$FISH_BIN" "$@"
fi
